import tkinter as tk

def low(x):
    if x <= 30:
        return 1
    elif x < 50:
        return (50 - x) / 20
    return 0

def medium(x):
    if 30 < x < 50:
        return (x - 30) / 20
    elif 50 <= x < 70:
        return (70 - x) / 20
    return 0

def high(x):
    if x >= 70:
        return 1
    elif x > 50:
        return (x - 50) / 20
    return 0


def near(x):
    if x <= 30:
        return 1
    elif x < 50:
        return (50 - x) / 20
    return 0

def normal(x):
    if 30 < x < 50:
        return (x - 30) / 20
    elif 50 <= x < 70:
        return (70 - x) / 20
    return 0

def far(x):
    if x >= 70:
        return 1
    elif x > 50:
        return (x - 50) / 20
    return 0


def evaluate(blur, strain, dist):
    # fuzzify inputs
    b_low, b_med, b_high = low(blur), medium(blur), high(blur)
    s_low, s_med, s_high = low(strain), medium(strain), high(strain)
    d_near, d_norm, d_far = near(dist), normal(dist), far(dist)

    # RULES

    # GOOD condition
    good = max(
        min(b_low, s_low, d_norm),
        min(b_low, s_low, d_far)
    )

    # MODERATE condition
    moderate = max(
        min(b_med, s_med),
        min(b_low, s_high),
        min(b_high, s_low)
    )

    # BAD condition
    bad = max(
        min(b_high, s_high),
        min(b_high, d_near),
        min(s_high, d_near)
    )

    # DEFUZZIFICATION (weighted)
    num = good*1 + moderate*2 + bad*3
    den = good + moderate + bad

    if den == 0:
        return "No Result"

    result = num / den

    if result < 1.5:
        return "GOOD 👁️"
    elif result < 2.5:
        return "MODERATE ⚠️"
    else:
        return "BAD ❗"


def run():
    blur = blur_slider.get()
    strain = strain_slider.get()
    dist = dist_slider.get()

    result = evaluate(blur, strain, dist)
    result_label.config(text="Eye Condition: " + result)


root = tk.Tk()
root.title("Eye Test Fuzzy System")

tk.Label(root, text="Blur Level").pack()
blur_slider = tk.Scale(root, from_=0, to=100, orient="horizontal")
blur_slider.pack()

tk.Label(root, text="Eye Strain").pack()
strain_slider = tk.Scale(root, from_=0, to=100, orient="horizontal")
strain_slider.pack()

tk.Label(root, text="Distance from Screen (cm)").pack()
dist_slider = tk.Scale(root, from_=0, to=100, orient="horizontal")
dist_slider.pack()

tk.Button(root, text="Check Eye Condition", command=run).pack()

result_label = tk.Label(root, text="Eye Condition: ")
result_label.pack()

root.mainloop()
